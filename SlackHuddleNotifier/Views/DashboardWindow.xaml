<Window x:Class="SlackHuddleNotifier.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slack Huddle Notifier"
        Width="520" Height="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF6F7F9">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE3E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF667085"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Slack Huddle Notifier" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Status &amp; priority users" Style="{StaticResource Label}"/>
        </StackPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFB0B7C0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#FF2FA84F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status.StatusMessage}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Account" Style="{StaticResource Label}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Account, TargetNullValue='—'}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Workspace" Style="{StaticResource Label}" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Team, TargetNullValue='—'}" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Detection" Style="{StaticResource Label}" Margin="0,5,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Status.Mode}"/>
                        <TextBlock Text="{Binding Status.CredentialSource, StringFormat=' · {0}'}" Style="{StaticResource Label}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Priority heading -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Priority users" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Huddles from these people get a louder, priority notification."
                       Style="{StaticResource Label}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Priority editor -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Current priority users -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="6" MaxHeight="150">
                <Grid>
                    <TextBlock Text="No priority users yet." Margin="8,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PriorityUsers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PriorityUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Remove" Padding="8,2"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Add label -->
            <TextBlock Grid.Row="1" Text="Add a priority user" FontWeight="SemiBold" Margin="2,14,0,4"/>

            <!-- Search box -->
            <TextBox Grid.Row="2" Padding="8,6"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Type a name to search your workspace…"/>

            <!-- Search results -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="Add" Padding="12,2"
                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Directory status -->
            <TextBlock Grid.Row="4" Text="{Binding DirectoryStatus}" Style="{StaticResource Label}" Margin="2,10,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
