<Window x:Class="SlackHuddleNotifier.Views.HuddlePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SlackHuddleNotifier.ViewModels"
        Title="Slack Huddle"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A154B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#611f69"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3a0f3a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#1D1C1D"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D1D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="White"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="20" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="16,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#4A154B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F3A7;" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Slack Huddle Started"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.85"/>
                        <TextBlock Text="PRIORITY USER"
                                   Foreground="#FFD700"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Visibility="{Binding IsPriorityUser, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="{Binding InitiatorName}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1D1C1D"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ChannelDisplay}"
                           FontSize="15"
                           Foreground="#616061"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TimeDisplay}"
                           FontSize="12"
                           Foreground="#9E9EA6"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,0,20,20"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Dismiss"
                        Command="{Binding DismissCommand}"
                        Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Join Huddle"
                        Command="{Binding JoinHuddleCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
