<Window x:Class="SlackHuddleNotifier.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Slack Huddle Notifier"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF6F7F9">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF667085"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22">
        <TextBlock Text="Slack Huddle Notifier" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Version, StringFormat='Version {0} · prototype'}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap">
            Watches your Slack workspace and, the moment someone starts a <Run Text="huddle" FontWeight="SemiBold"/>,
            pops a big, hard-to-miss notification so you don't miss it — even when Slack is buried
            behind other windows.
        </TextBlock>

        <TextBlock Text="How it works" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <TextBlock Style="{StaticResource Muted}">
            It connects to Slack the same way your own client does and listens for huddle-start
            events in the conversations you're a member of. Priority users (set in the dashboard)
            get an extra-prominent alert.
        </TextBlock>

        <Border Background="White" BorderBrush="#FFE3E6EA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Detection" Style="{StaticResource Muted}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Mode}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Signed in as" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Account, TargetNullValue='—'}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.Team, TargetNullValue='—'}" Margin="0,5,0,0"/>
            </Grid>
        </Border>

        <Button Content="Close" HorizontalAlignment="Right" Padding="18,5" Margin="0,18,0,0" IsCancel="True"/>
    </StackPanel>
</Window>
