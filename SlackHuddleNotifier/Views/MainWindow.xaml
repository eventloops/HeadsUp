<Window x:Class="SlackHuddleNotifier.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="SlackHuddleNotifier"
        Width="0" Height="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">

    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Slack Huddle Notifier"
                        IconSource="/Assets/tray.ico">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding StatusText}" IsEnabled="False" FontWeight="SemiBold"/>
                    <Separator/>
                    <MenuItem Header="About..." Command="{Binding ShowAboutCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
