<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HeadsUp.AvaloniaApp.App">

    <Application.Styles>
        <FluentTheme/>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray.png" ToolTipText="Slack Huddle Notifier">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Connecting..." IsEnabled="False"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Test notification" Click="OnTestNotificationClicked"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Exit" Click="OnExitClicked"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
