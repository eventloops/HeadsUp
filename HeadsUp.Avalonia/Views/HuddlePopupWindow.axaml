<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HeadsUp.AvaloniaApp.Views.HuddlePopupWindow"
        Title="Slack Huddle"
        Width="400"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">

    <Window.Styles>
        <!-- Aubergine accent; red when the window carries the "priority" class. -->
        <Style Selector="Border.accent">
            <Setter Property="Background" Value="#4A154B"/>
        </Style>
        <Style Selector="Window.priority Border.accent">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>

        <Style Selector="Button.join">
            <Setter Property="Background" Value="#4A154B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>
        <Style Selector="Button.join:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#611f69"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Window.priority Button.join">
            <Setter Property="Background" Value="#007A5A"/>
        </Style>
        <Style Selector="Window.priority Button.join:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#00694E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.dismiss">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#1D1C1D"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>
        <Style Selector="Button.dismiss:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D1D1D1"/>
            <Setter Property="Foreground" Value="#1D1C1D"/>
        </Style>

        <!-- Pulsing header icon -->
        <Style Selector="TextBlock.pulse">
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.18"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.18"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border CornerRadius="12"
            Background="White"
            Margin="8"
            BoxShadow="0 4 20 0 #40000000">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <!-- Header bar -->
            <Border Grid.Row="0" Classes="accent" CornerRadius="12,12,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Classes="pulse" Text="&#x1F3A7;" FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Slack huddle started"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.85"/>
                        <TextBlock Text="PRIORITY USER"
                                   Foreground="#FFD700"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   IsVisible="{Binding IsPriorityUser}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body: avatar + who/where -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="20,16,20,4">
                <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border CornerRadius="22" Background="#EEEDFE">
                        <TextBlock Text="{Binding Initials}"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#3C3489"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse x:Name="AvatarEllipse"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InitiatorName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1D1C1D"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="13"
                               Foreground="#616061"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,8,20,14"
                        Spacing="10">
                <Button Classes="dismiss" Content="Dismiss" Command="{Binding DismissCommand}"/>
                <Button Classes="join" Content="Join huddle" Command="{Binding JoinHuddleCommand}"/>
            </StackPanel>

            <!-- Countdown until auto-dismiss -->
            <Border Grid.Row="3" Height="4" Background="#E8E8E8" CornerRadius="0,0,12,12">
                <Border x:Name="CountdownFill"
                        Classes="accent"
                        CornerRadius="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="0%,50%">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
