<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm dark theme — signal amber on warm ink. -->
    <Color x:Key="BgColor">#1A1712</Color>
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#23201B"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="#2D2921"/>
    <SolidColorBrush x:Key="BrushLine" Color="#3A342C"/>

    <SolidColorBrush x:Key="BrushText" Color="#F4EEE3"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#A79E8D"/>
    <SolidColorBrush x:Key="BrushFaint" Color="#756D5E"/>

    <Color x:Key="AccentColor">#F5A623</Color>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BrushAccentPress" Color="#FFBC42"/>
    <SolidColorBrush x:Key="BrushAccentInk" Color="#1A1509"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#3C2D13"/>
    <SolidColorBrush x:Key="BrushAccentText" Color="#FFC24D"/>

    <SolidColorBrush x:Key="BrushJoin" Color="#2FBF6A"/>
    <SolidColorBrush x:Key="BrushJoinPress" Color="#26A85C"/>
    <SolidColorBrush x:Key="BrushPriority" Color="#F0453B"/>
    <SolidColorBrush x:Key="BrushPriorityPress" Color="#D53B32"/>
    <SolidColorBrush x:Key="BrushGold" Color="#FFD24A"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#3A211E"/>

    <!-- Selected nav-item background (amber wash) -->
    <SolidColorBrush x:Key="BrushNavSelected" Color="#33281A"/>
</ResourceDictionary>
