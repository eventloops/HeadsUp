<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Clean light theme — amber accent on light cool greys. -->
    <Color x:Key="BgColor">#F5F6F8</Color>
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSurface2" Color="#EFF1F4"/>
    <SolidColorBrush x:Key="BrushLine" Color="#E5E7EB"/>

    <SolidColorBrush x:Key="BrushText" Color="#101828"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#667085"/>
    <SolidColorBrush x:Key="BrushFaint" Color="#98A2B3"/>

    <Color x:Key="AccentColor">#F5A623</Color>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BrushAccentPress" Color="#E3960C"/>
    <SolidColorBrush x:Key="BrushAccentInk" Color="#1A1509"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#FFF4E1"/>
    <SolidColorBrush x:Key="BrushAccentText" Color="#B9740A"/>

    <SolidColorBrush x:Key="BrushJoin" Color="#1AA35A"/>
    <SolidColorBrush x:Key="BrushJoinPress" Color="#178A4C"/>
    <SolidColorBrush x:Key="BrushPriority" Color="#E5463C"/>
    <SolidColorBrush x:Key="BrushPriorityPress" Color="#CB3B32"/>
    <SolidColorBrush x:Key="BrushGold" Color="#FFD24A"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#FBECEA"/>

    <!-- Selected nav-item background (amber wash) -->
    <SolidColorBrush x:Key="BrushNavSelected" Color="#FDF0D9"/>
</ResourceDictionary>
