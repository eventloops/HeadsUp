<Window x:Class="HeadsUp.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeadsUp"
        Title="Heads-Up"
        Width="800" Height="580" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EqualsBoolConverter x:Key="EqBool"/>
        <local:EqualsVisibilityConverter x:Key="EqVis"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Faint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushFaint}"/>
        </Style>

        <!-- Accent (Add) button -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource BrushAccent}" CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccentPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet (Remove / Mute) button -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,4">
                            <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushDangerSoft}"/>
                                <Setter TargetName="c" Property="TextElement.Foreground" Value="{StaticResource BrushPriority}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="11,9" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ico" Grid.Column="0" Text="{TemplateBinding Tag}" FontSize="14"
                                           Margin="2,0,12,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushMuted}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushNavSelected}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="ico" Property="Foreground" Value="{StaticResource BrushAccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme choice card -->
        <Style x:Key="ThemeOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{StaticResource BrushSurface}" CornerRadius="10"
                                BorderBrush="{StaticResource BrushLine}" BorderThickness="2" Padding="14" Width="150">
                            <StackPanel>
                                <Border CornerRadius="6" Height="52" Background="{TemplateBinding Background}"/>
                                <TextBlock Text="{TemplateBinding Content}" Margin="0,10,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushMuted}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,18,18">
                    <Image Source="{StaticResource MarkAmber}" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="Heads-Up" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x25C9;" Content="Overview"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EqBool}, ConverterParameter=Overview}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x1F514;" Content="Alerts"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EqBool}, ConverterParameter=Alerts}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x2605;" Content="Priority people"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EqBool}, ConverterParameter=Priority}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#x1F3A8;" Content="Appearance"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource EqBool}, ConverterParameter=Appearance}"/>
                </StackPanel>

                <!-- Connection status footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,0,18,18">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushFaint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource BrushJoin}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status.StatusMessage}" Style="{StaticResource Faint}"
                               FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1" Margin="28,24,28,24">

            <!-- Overview -->
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource EqVis}, ConverterParameter=Overview}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Overview" Style="{StaticResource H1}" Margin="0,0,0,16"/>

                <!-- Status card -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <Border Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                                CornerRadius="8" Padding="10,7" Margin="0,0,0,12"
                                Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F515;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MuteStatus}" Foreground="{StaticResource BrushAccentText}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Account" Style="{StaticResource Muted}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Account, TargetNullValue='—'}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Workspace" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Team, TargetNullValue='—'}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Detection" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Status.Mode}"/>
                                <TextBlock Text="{Binding Status.CredentialSource, StringFormat=' · {0}'}" Style="{StaticResource Faint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="2,0,0,8">
                    <TextBlock Text="Recent alerts" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Content="Clear" Command="{Binding ClearHistoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RemoveButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentAlerts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <TextBlock Text="No alerts yet — they'll appear here as they arrive." Margin="8,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentAlerts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Open in Slack">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34" Grid.Column="0" Margin="0,0,11,0" VerticalAlignment="Top">
                                                    <Ellipse Fill="{StaticResource BrushAccentSoft}"/>
                                                    <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                                               FontSize="12" Foreground="{StaticResource BrushAccentText}"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding InitiatorName}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Headline, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource Faint}"
                                                               FontSize="12" HorizontalAlignment="Right" Margin="10,1,2,0"/>
                                                    <Button Content="Mute channel" Style="{StaticResource RemoveButton}"
                                                            FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                            Visibility="{Binding CanMute, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.MuteChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="Stop alerting from this channel"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Muted channels -->
                <Border Grid.Row="4" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                        CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MutedChannels.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Muted channels — no alerts from these" Style="{StaticResource Faint}"
                                   FontSize="11" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding MutedChannels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                            CornerRadius="12" Padding="9,3" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name, StringFormat='#{0}'}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Content="✕" FontSize="11" Margin="7,0,0,0" Padding="2,0"
                                                    Foreground="{StaticResource BrushFaint}" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.UnmuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Unmute"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alerts -->
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource EqVis}, ConverterParameter=Alerts}">
                <StackPanel>
                    <TextBlock Text="Alerts" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose what Heads-Up taps you on the shoulder for." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Huddles" IsChecked="{Binding NotifyHuddles}" Margin="0,4"/>
                            <CheckBox Content="Mentions of me" IsChecked="{Binding NotifyMentions}" Margin="0,4"/>
                            <CheckBox Content="Direct messages" IsChecked="{Binding NotifyDirectMessages}" Margin="0,4"/>
                            <CheckBox Content="Keywords" IsChecked="{Binding NotifyKeywords}" Margin="0,4"/>
                            <TextBox Margin="29,6,0,0" IsEnabled="{Binding NotifyKeywords}"
                                     Text="{Binding KeywordsText, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="Comma-separated words to watch for (e.g. deploy, incident, your project)."
                                       Style="{StaticResource Faint}" FontSize="11" Margin="29,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Priority people -->
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource EqVis}, ConverterParameter=Priority}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Priority people" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Text="Alerts from these people get a louder, incoming-call notification."
                           Style="{StaticResource Muted}" Margin="0,0,0,14"/>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" MaxHeight="180">
                    <Grid>
                        <TextBlock Text="No priority people yet." Margin="8,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PriorityUsers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PriorityUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="30" Height="30" Grid.Column="0" Margin="0,0,10,0">
                                                    <Ellipse Fill="{StaticResource BrushSurface2}"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Content="Remove" Style="{StaticResource RemoveButton}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3" Text="Add a priority person" Style="{StaticResource H2}" FontSize="13" Margin="2,16,0,6"/>

                <Border Grid.Row="4" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                    <Grid>
                        <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Height="38"
                                 Foreground="{StaticResource BrushText}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Type a name to search your workspace…" Foreground="{StaticResource BrushFaint}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource Card}" Padding="8" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" Grid.Column="0" Margin="0,0,10,0">
                                                <Ellipse Fill="{StaticResource BrushSurface2}"/>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="Add" Style="{StaticResource AddButton}"
                                                    Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="6" Text="{Binding DirectoryStatus}" Style="{StaticResource Faint}" Margin="2,10,0,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- Appearance -->
            <Grid Visibility="{Binding SelectedSection, Converter={StaticResource EqVis}, ConverterParameter=Appearance}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H1}" Margin="0,0,0,4"/>
                    <TextBlock Text="How Heads-Up looks." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                    <TextBlock Text="Theme" Style="{StaticResource H2}" FontSize="13" Margin="2,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ThemeOption}" GroupName="theme" Content="Dark" Margin="0,0,14,0"
                                     Background="#23201B"
                                     IsChecked="{Binding SelectedThemeName, Converter={StaticResource EqBool}, ConverterParameter=Dark}"/>
                        <RadioButton Style="{StaticResource ThemeOption}" GroupName="theme" Content="Light"
                                     Background="#F5F6F8"
                                     IsChecked="{Binding SelectedThemeName, Converter={StaticResource EqBool}, ConverterParameter=Light}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
