<Window x:Class="HeadsUp.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heads-Up"
        Width="560" Height="760" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Faint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushFaint}"/>
        </Style>

        <!-- Accent (Add) button — amber with ink text -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource BrushAccent}" CornerRadius="7" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccentPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet (Remove / Mute) button — muted, red on hover -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,4">
                            <ContentPresenter x:Name="c" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushDangerSoft}"/>
                                <Setter TargetName="c" Property="TextElement.Foreground" Value="{StaticResource BrushPriority}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hoverable list row -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clickable list row (button that looks like a hover row) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal underline tabs -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="2,4" Margin="0,0,20,0">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: the Rise mark + wordmark -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,18">
            <Image Source="{StaticResource MarkAmber}" Width="30" Height="30" Margin="0,3,13,0" VerticalAlignment="Top"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Heads-Up" Style="{StaticResource H1}"/>
                <TextBlock Text="Your lookout for Slack" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushFaint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource BrushJoin}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status.StatusMessage}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Muted banner (snooze / Slack DND) -->
                <Border Background="{StaticResource BrushAccentSoft}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                        CornerRadius="8" Padding="10,7" Margin="0,0,0,12"
                        Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F515;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MuteStatus}" Foreground="{StaticResource BrushAccentText}" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Account" Style="{StaticResource Muted}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Account, TargetNullValue='—'}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Workspace" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Team, TargetNullValue='—'}" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Detection" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Status.Mode}"/>
                        <TextBlock Text="{Binding Status.CredentialSource, StringFormat=' · {0}'}" Style="{StaticResource Faint}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Notify me about -->
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="Notify me about" Style="{StaticResource H2}" Margin="2,0,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Huddles" IsChecked="{Binding NotifyHuddles}" Margin="0,3"/>
                    <CheckBox Content="Mentions of me" IsChecked="{Binding NotifyMentions}" Margin="0,3"/>
                    <CheckBox Content="Direct messages" IsChecked="{Binding NotifyDirectMessages}" Margin="0,3"/>
                    <CheckBox Content="Keywords" IsChecked="{Binding NotifyKeywords}" Margin="0,3"/>
                    <TextBox Margin="22,4,0,0" Padding="8,6"
                             IsEnabled="{Binding NotifyKeywords}"
                             Text="{Binding KeywordsText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="Comma-separated words to watch for (e.g. deploy, incident, your project)."
                               Style="{StaticResource Faint}" FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Recent alerts + Priority users -->
        <TabControl Grid.Row="3">
        <TabItem Header="Recent alerts">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,8">
                <TextBlock Text="What you've been alerted to this session." Style="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Content="Clear"
                        Command="{Binding ClearHistoryCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RemoveButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentAlerts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <TextBlock Text="No alerts yet — they'll appear here as they arrive." Margin="8,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentAlerts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Open in Slack">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="34" Height="34" Grid.Column="0" Margin="0,0,11,0" VerticalAlignment="Top">
                                                <Ellipse Fill="{StaticResource BrushAccentSoft}"/>
                                                <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           FontSize="12" Foreground="{StaticResource BrushAccentText}"/>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding InitiatorName}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Headline, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource Faint}"
                                                           FontSize="12" HorizontalAlignment="Right" Margin="10,1,2,0"/>
                                                <Button Content="Mute channel" Style="{StaticResource RemoveButton}"
                                                        FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                        Visibility="{Binding CanMute, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.MuteChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Stop alerting from this channel"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Muted channels -->
            <Border Grid.Row="2" Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MutedChannels.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Muted channels — no alerts from these" Style="{StaticResource Faint}"
                               FontSize="11" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding MutedChannels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                        CornerRadius="12" Padding="9,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name, StringFormat='#{0}'}" VerticalAlignment="Center" FontSize="12"/>
                                        <Button Content="✕" FontSize="11" Margin="7,0,0,0" Padding="2,0"
                                                Foreground="{StaticResource BrushFaint}" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" VerticalAlignment="Center"
                                                Command="{Binding DataContext.UnmuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Unmute"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        </TabItem>

        <TabItem Header="Priority users">
        <!-- Priority editor -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Alerts from these people get a louder, priority notification."
                       Style="{StaticResource Muted}" Margin="2,0,0,10"/>

            <!-- Current priority users -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" MaxHeight="150">
                <Grid>
                    <TextBlock Text="No priority users yet." Margin="8,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Faint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PriorityUsers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PriorityUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30" Grid.Column="0" Margin="0,0,10,0">
                                                <Ellipse Fill="{StaticResource BrushSurface2}"/>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource RemoveButton}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Add label -->
            <TextBlock Grid.Row="2" Text="Add a priority user" Style="{StaticResource H2}" FontSize="13" Margin="2,16,0,6"/>

            <!-- Search box with placeholder -->
            <Border Grid.Row="3" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="10,0">
                <Grid>
                    <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Height="36"
                             Foreground="{StaticResource BrushText}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Type a name to search your workspace…" Foreground="{StaticResource BrushFaint}"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Search results -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8" Margin="0,10,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="30" Height="30" Grid.Column="0" Margin="0,0,10,0">
                                            <Ellipse Fill="{StaticResource BrushSurface2}"/>
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="Add" Style="{StaticResource AddButton}"
                                                Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Directory status -->
            <TextBlock Grid.Row="5" Text="{Binding DirectoryStatus}" Style="{StaticResource Faint}" Margin="2,10,0,0" TextWrapping="Wrap"/>
        </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
