<Window x:Class="HeadsUp.Views.SlackAppSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HeadsUp"
        Title="Connect Heads-Up to Slack"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource BrushAccent}" CornerRadius="10" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccentPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="34,30,34,24">
        <!-- Brand -->
        <Image Source="{StaticResource MarkAmber}" Width="44" Height="44" HorizontalAlignment="Center"/>
        <TextBlock Text="Connect with a Slack app" HorizontalAlignment="Center" Margin="0,12,0,0"
                   FontSize="21" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                   Foreground="{StaticResource BrushMuted}" FontSize="13" Margin="0,6,0,0"
                   Text="Slack only issues app-level tokens from its own settings page, so this part is manual. It takes about a minute, once."/>

        <!-- Step 1 -->
        <Grid Margin="0,24,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StepNumber}">
                <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushAccentText}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Create your Heads-Up app" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource BrushText}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,2,0,0"
                           Text="Opens Slack with everything prefilled — just pick your workspace and confirm."/>
                <Button Content="Create your Heads-Up Slack app" Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding CreateAppCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Step 2 -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StepNumber}">
                <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushAccentText}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Generate an app-level token" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource BrushText}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,2,0,0"
                           Text="In the new app: Basic Information → App-Level Tokens → Generate. Add the connections:write scope."/>
            </StackPanel>
        </Grid>

        <!-- Step 3 -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StepNumber}">
                <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushAccentText}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Paste both values here" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource BrushText}"/>

                <TextBlock Text="Client ID" Foreground="{StaticResource BrushFaint}" FontSize="11"
                           FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="App-level token" Foreground="{StaticResource BrushFaint}" FontSize="11"
                           FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding AppToken, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Validation -->
        <Border Margin="0,14,0,0" CornerRadius="8" Padding="12,9"
                Background="{StaticResource BrushSurface2}"
                Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{StaticResource BrushAccentText}"/>
        </Border>

        <!-- Actions -->
        <Button Content="Sign in with Slack" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                Command="{Binding ConfirmCommand}"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="11.5"
                   Foreground="{StaticResource BrushFaint}" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Your browser opens Slack to authorise. Tokens are stored encrypted on this machine."/>
        <Grid Margin="0,6,0,0">
            <Button Content="Setup guide" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Command="{Binding OpenSetupGuideCommand}"/>
            <Button Content="Cancel" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}"/>
        </Grid>
    </StackPanel>
</Window>
