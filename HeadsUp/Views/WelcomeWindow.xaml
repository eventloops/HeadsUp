<Window x:Class="HeadsUp.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Heads-Up"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Toggle switch: a restyled CheckBox, green when on -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="38" Height="22" CornerRadius="11"
                                Background="{StaticResource BrushLine}">
                            <Border x:Name="thumb" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#40000000" BlurRadius="3" ShadowDepth="1" Direction="270"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource BrushJoin}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource BrushAccent}" CornerRadius="10" Padding="18,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccentPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One alert-kind row: icon tile, name + description, toggle -->
        <Style x:Key="FlagIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
        </Style>
    </Window.Resources>

    <Grid>
    <!-- Setup: pick alert kinds, then Connect -->
    <StackPanel Margin="34,32,34,26">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <!-- Brand -->
        <Image Source="{StaticResource MarkAmber}" Width="52" Height="52" HorizontalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="27" FontWeight="Bold"
                   Foreground="{StaticResource BrushText}">
            <Run Text="Heads-"/><Run Text="Up" Foreground="{StaticResource BrushAccentText}"/>
        </TextBlock>
        <TextBlock Text="I'll keep an eye on Slack and tap you on the shoulder when it counts."
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource BrushMuted}" FontSize="14" Margin="0,6,0,0" MaxWidth="330"/>

        <!-- What I'll flag -->
        <TextBlock Text="WHAT I'LL FLAG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushFaint}"
                   Margin="2,26,0,8"/>
        <StackPanel>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FlagIcon}"><TextBlock Text="🎧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Huddles" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="Someone starts one in your channels or DMs" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding NotifyHuddles}"/>
            </Grid>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FlagIcon}"><TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Mentions" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="A message that @-mentions you" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding NotifyMentions}"/>
            </Grid>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FlagIcon}"><TextBlock Text="✉" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Direct messages" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="Off by default — DMs can be chatty" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding NotifyDirectMessages}"/>
            </Grid>
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FlagIcon}"><TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Keywords" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="Words you choose — set them in the dashboard" Foreground="{StaticResource BrushMuted}" FontSize="12"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding NotifyKeywords}"/>
            </Grid>
        </StackPanel>

        <!-- Actions -->
        <Button Content="Connect to Slack" Style="{StaticResource PrimaryButton}" Margin="0,26,0,0"
                Command="{Binding ConnectCommand}"/>
        <Button Content="I'll set it up later" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                Command="{Binding LaterCommand}"/>
        <TextBlock Text="Runs in your tray · no admin needed" HorizontalAlignment="Center"
                   Foreground="{StaticResource BrushFaint}" FontSize="11.5" Margin="0,14,0,0"/>
    </StackPanel>

    <!-- Connecting: shown after Connect, until connected or the sign-in window takes over -->
    <StackPanel Margin="34" VerticalAlignment="Center" MinHeight="300"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
        <StackPanel VerticalAlignment="Center">
            <Image Source="{StaticResource MarkAmber}" Width="52" Height="52" HorizontalAlignment="Center"/>
            <TextBlock Text="Connecting to Slack…" HorizontalAlignment="Center" Margin="0,16,0,0"
                       FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
            <TextBlock Text="Hang tight — signing you in." HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{StaticResource BrushMuted}" FontSize="13.5"/>
            <ProgressBar IsIndeterminate="True" Width="230" Height="4" Margin="0,22,0,0"
                         Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushSurface2}"
                         BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>
