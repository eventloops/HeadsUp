<Window x:Class="HeadsUp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="HeadsUp"
        Width="0" Height="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Heads-Up"
                        IconSource="/Assets/tray.ico"
                        DoubleClickCommand="{Binding OpenDashboardCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding Status.StatusMessage}" IsEnabled="False" FontWeight="SemiBold"/>
                    <MenuItem Header="{Binding MuteStatus}" IsEnabled="False"
                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                    <Separator/>
                    <MenuItem Header="Snooze alerts">
                        <MenuItem Header="For 30 minutes" Command="{Binding Snooze30Command}"/>
                        <MenuItem Header="For 1 hour" Command="{Binding Snooze1HourCommand}"/>
                        <MenuItem Header="Until tomorrow" Command="{Binding SnoozeUntilTomorrowCommand}"/>
                    </MenuItem>
                    <MenuItem Header="Resume alerts" Command="{Binding ResumeCommand}"
                              Visibility="{Binding IsManuallySnoozed, Converter={StaticResource BoolToVis}}"/>
                    <Separator/>
                    <MenuItem Header="Connect to Slack" Command="{Binding ConnectCommand}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Open dashboard…" Command="{Binding OpenDashboardCommand}"/>
                    <MenuItem Header="About…" Command="{Binding ShowAboutCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
