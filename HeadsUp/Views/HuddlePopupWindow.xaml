<Window x:Class="HeadsUp.Views.HuddlePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heads-Up"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{StaticResource BrushText}"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Join / primary action: green normally, red for a priority contact. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushJoin}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="Overlay" Background="Black" Opacity="0" CornerRadius="8"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushPriority}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header + countdown: soft amber normally, solid red for priority. -->
        <Style x:Key="HeaderBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushAccentSoft}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushPriority}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeadlineText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CountdownFillStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushPriority}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="{StaticResource BrushSurface}" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" Opacity="0.5" BlurRadius="26" ShadowDepth="5" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar: the Rise mark + headline -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="16,11" Style="{StaticResource HeaderBar}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="19" Height="19" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource MarkAmber}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                                        <Setter Property="Source" Value="{StaticResource MarkWhite}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="HeaderIconScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                        <Image.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="HeaderIconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.16" Duration="0:0:0.7"/>
                                        <DoubleAnimation Storyboard.TargetName="HeaderIconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.16" Duration="0:0:0.7"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Image.Triggers>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}" FontSize="13.5" FontWeight="SemiBold"
                                   Style="{StaticResource HeadlineText}"/>
                        <TextBlock Text="PRIORITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGold}"
                                   Margin="0,1,0,0"
                                   Visibility="{Binding IsPriorityUser, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body: avatar + who/where -->
            <Grid Grid.Row="1" Margin="20,17,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border CornerRadius="23" Background="{StaticResource BrushAccentSoft}">
                        <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InitiatorName}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource BrushMuted}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,10,20,16" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="Dismiss"
                        Command="{Binding DismissCommand}" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}"
                        Command="{Binding JoinHuddleCommand}"/>
            </StackPanel>

            <!-- Countdown until auto-dismiss -->
            <Border Grid.Row="3" Height="4" Background="{StaticResource BrushSurface2}" CornerRadius="0,0,14,14">
                <Border x:Name="CountdownFill" Style="{StaticResource CountdownFillStyle}"
                        CornerRadius="0,0,0,14" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
