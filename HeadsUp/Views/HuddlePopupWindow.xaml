<Window x:Class="HeadsUp.Views.HuddlePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HeadsUp.ViewModels"
        Title="Slack Huddle"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Hover/press darken via overlay so the base background can change per state. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4A154B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="Overlay" Background="#000000" Opacity="0" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Priority huddles get a green "incoming call" join button. -->
                <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                    <Setter Property="Background" Value="#007A5A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#1D1C1D"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D1D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header + countdown share the accent colour: aubergine, or red for priority. -->
        <Style x:Key="AccentBorder" TargetType="Border">
            <Setter Property="Background" Value="#4A154B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriorityUser}" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="White"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="20" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="16,10"
                    Style="{StaticResource AccentBorder}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderIcon"
                               Text="{Binding Icon}" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="HeaderIconScale" ScaleX="1" ScaleY="1"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="HeaderIconScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1" To="1.18" Duration="0:0:0.6"/>
                                        <DoubleAnimation Storyboard.TargetName="HeaderIconScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1" To="1.18" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Opacity="0.85"/>
                        <TextBlock Text="PRIORITY USER"
                                   Foreground="#FFD700"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Visibility="{Binding IsPriorityUser, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body: avatar + who/where -->
            <Grid Grid.Row="1" Margin="20,16,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Initials circle underneath; profile photo fades in over it when it loads. -->
                <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border CornerRadius="22" Background="#EEEDFE">
                        <TextBlock Text="{Binding Initials}"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#3C3489"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InitiatorName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1D1C1D"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="13"
                               Foreground="#616061"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,8,20,14"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Dismiss"
                        Command="{Binding DismissCommand}"
                        Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="{Binding ActionLabel}"
                        Command="{Binding JoinHuddleCommand}"/>
            </StackPanel>

            <!-- Countdown until auto-dismiss -->
            <Border Grid.Row="3" Height="4" Background="#E8E8E8" CornerRadius="0,0,12,12">
                <Border x:Name="CountdownFill"
                        Style="{StaticResource AccentBorder}"
                        CornerRadius="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" ScaleX="1"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
