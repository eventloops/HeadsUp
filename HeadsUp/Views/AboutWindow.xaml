<Window x:Class="HeadsUp.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Heads-Up"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}">
    <Window.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushAccentInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource BrushAccent}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushAccentPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource MarkAmber}" Width="34" Height="34" Margin="0,2,14,0" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="Heads-Up" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Version, StringFormat='Your lookout for Slack · v{0} · prototype'}"
                           Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap">
            <Run Text="Heads-Up" FontWeight="SemiBold"/> watches your Slack and taps you on the shoulder
            when it matters — huddles, @mentions, DMs, and keywords — with an alert that's hard to miss,
            even when Slack is buried behind other windows.
        </TextBlock>

        <TextBlock Text="How it works" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <TextBlock Style="{StaticResource Muted}">
            It connects to Slack the same way your own client does and listens for the activity you've
            turned on. Priority users get an incoming-call-style alert; snooze or your Slack Do Not Disturb
            keep it quiet; and you can mute noisy channels from the dashboard.
        </TextBlock>

        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Detection" Style="{StaticResource Muted}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Mode}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Signed in as" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Account, TargetNullValue='—'}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.Team, TargetNullValue='—'}" Margin="0,5,0,0"/>
            </Grid>
        </Border>

        <Button Content="Close" HorizontalAlignment="Right" Padding="20,7" Margin="0,20,0,0" IsCancel="True"/>
    </StackPanel>
</Window>
