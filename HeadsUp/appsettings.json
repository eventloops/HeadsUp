{
  "Detection": {
    "Connectors": [
      { "Type": "SlackClientApi" }
    ]
  },
  // SlackApi mode. Normally left empty: the Connect screen collects the client id and
  // app-level token and stores them encrypted, alongside the OAuth tokens. Fill these in
  // only to bypass that prompt (headless/dev). See docs/slack-app-setup.md.
  "Slack": {
    "ClientId": "",
    "AppToken": "",
    "UserToken": ""
  },
  "SlackClient": {
    "CredentialSource": "WebView2",
    "ClientToken": "",
    "Cookie": "",
    "WorkspaceUrl": ""
  },
  "Notification": {
    "PlaySound": true,
    "SoundFilePath": "",
    "ToastDurationSeconds": 15
  },
  "Logging": {
    "MinimumLevel": "Information"
  }
}
