<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- Keep the original namespaces so platform heads don't churn. -->
    <RootNamespace>SlackHuddleNotifier</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="SlackNet" Version="0.17.10" />
    <PackageReference Include="SlackNet.Extensions.DependencyInjection" Version="0.17.10" />
  </ItemGroup>

</Project>
