{
  // The org's single Slack app. Real values belong in appsettings.Local.json (git-ignored),
  // environment variables, or your deployment's secret store -- never in here.
  "Relay": {
    // App-level token. Generate it with BOTH scopes:
    //   connections:write   -- opens the Socket Mode connection
    //   authorizations:read -- expands a truncated authorizations list
    // Without the second, events visible to many people reach only one of them.
    // App-level tokens don't rotate, so nothing here needs renewing.
    "AppToken": "",

    // Used to start the OAuth flow and, with the secret, to complete it. The relay is the
    // OAuth client so that users face a single consent screen.
    "ClientId": "",
    "ClientSecret": "",

    // The relay's externally reachable base URL. Slack redirects here after consent, so it
    // must match the app's registered redirect URL. Only OAuth needs this reachable --
    // event ingress dials out over Socket Mode.
    "PublicUrl": "http://localhost:5285",

    // Signs desktop sessions. Generated at startup when unset, which means sessions don't
    // survive a restart. Rotating it revokes every session at once.
    "SessionSigningKey": "",

    // Logs every Socket Mode frame (credentials redacted). Diagnostic only.
    "LogRawFrames": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
